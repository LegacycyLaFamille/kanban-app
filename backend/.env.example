PORT=3000
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=kanban_password
POSTGRES_DB=kanban_db
DATABASE_URL="postgresql://foo:bar@baz:port/kanban_db"
JWT_SECRET=zenithisdeadlonglivezenith.app

# RabbitMQ (see docs/backend/RABBITMQ.md). Leave RABBITMQ_HOST and
# RABBITMQ_URL unset to run the backend without a broker.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=kanban
RABBITMQ_PASSWORD=change-me
# RABBITMQ_VHOST=/
# RABBITMQ_URL=amqp://user:password@host:5672/%2F  # overrides the values above
# RABBITMQ_PREFETCH=10

OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=kanban-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_SEMCONV_STABILITY_OPT_IN=http
LOG_LEVEL=info
