// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// System-wide role, orthogonal to per-project ownership/membership
// (ProjectAccessGuard). USER is the default for every new account; there is
// no admin-management UI yet, so the first ADMIN is promoted manually — see
// docs/backend/ADMIN_ROLE.md.
enum Role {
  USER
  ADMIN
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  passwordHash  String
  refreshToken  String?
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Project       Project[]
  ProjectMember ProjectMember[]
  AssignedTask  Task[]          @relation("TaskAssignee")
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  Task        Task[]
  Board       Board[]
  Member      ProjectMember[]
}

// A project always has exactly one owner (Project.ownerId), who has full
// read/write/delete/membership-management rights. ProjectMember records
// grant additional users read-only access to a project without making them
// owners; the owner is intentionally not duplicated as a ProjectMember row
// so there is a single source of truth for ownership.
//
// Per ADR-007, legacy Todo records are never migrated into this domain, so
// there is no legacy data here that could exist without a valid owner or
// membership row — both userId and projectId are required, non-nullable.
model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Board {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Read-only archive of the legacy `todo_items` table, filled by the one-shot
// script `src/scripts/migrate-legacy-data.ts`. Per ADR-007 these rows carry
// no ownership: they are intentionally NOT linked to User/Project/Task and
// are not exposed by any API route. `id` is the legacy id kept as-is so the
// script can be re-run safely (upsert).
model LegacyTodoItem {
  id         String   @id
  name       String?
  completed  Boolean  @default(false)
  source     String
  migratedAt DateTime @default(now())
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String
  priority    String
  deadline    DateTime?
  boardId     String?
  board       Board?    @relation(fields: [boardId], references: [id], onDelete: SetNull)
  // Admin-only assignment (admin dashboard ticket). Nullable: a task can be
  // unassigned, and assigning is restricted server-side to users who already
  // have access to the task's project (owner or ProjectMember) — see
  // AdminTaskService.assign(). Clears automatically if the assignee is
  // deleted, it does not delete the task.
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
